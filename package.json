{
  "name": "framebase-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Screen recorder and video editor that people and AI agents (via MCP) can drive",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "electron test/e2e/run.js",
    "lint": "eslint .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.17.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "allowScripts": {
    "electron@45.1.0": true
  },
  "dependencies": {
    "@fix-webm-duration/fix": "^1.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "author": "agent9ether",
  "build": {
    "appId": "dev.framebase.studio",
    "productName": "FrameBase Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "control-preload.js",
      "agent-server.js",
      "media-tools.js",
      "webm-duration.js",
      "edit-timing.js",
      "index.html",
      "mini-control.html",
      "renderer.js",
      "agent-ui.js",
      "mini-control.js",
      "*.css",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FrameBase records your microphone when you turn on \"Record microphone\".",
        "NSAudioCaptureUsageDescription": "FrameBase records the sound your Mac plays when you turn on \"Record system audio\"."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
